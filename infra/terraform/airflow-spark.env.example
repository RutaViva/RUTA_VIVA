AWS_REGION=us-east-1
POSTGRES_DB=rutaviva_db
RDS_HOST=replace-with-private-rds-hostname
RDS_MASTER_USER=admin

AIRFLOW_META_PASSWORD=replace-with-64-hex-characters
AIRFLOW_POSTGRES_USER=airflow_reader
AIRFLOW_POSTGRES_PASSWORD=replace-with-64-hex-characters
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-password
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_API_JWT_SECRET=replace-with-64-hex-characters
AIRFLOW_API_SECRET_KEY=replace-with-64-hex-characters
AIRFLOW_UID=50000

S3_BRONZE_PATH=s3a://replace-with-data-lake-bucket/bronze
S3_SILVER_PATH=s3a://replace-with-data-lake-bucket/silver
S3_QUARANTINE_PATH=s3a://replace-with-data-lake-bucket/quarantine
S3_GOLD_PATH=s3a://replace-with-data-lake-bucket/gold
S3_F1_PATH=s3a://replace-with-data-lake-bucket/bronze/f1
S3_WEATHER_PATH=s3a://replace-with-data-lake-bucket/bronze/f3
S3_EVENTS_PATH=s3a://replace-with-data-lake-bucket/bronze/f7
S3_TRIP_REQUESTS_PATH=s3a://replace-with-data-lake-bucket/bronze/operational/trip_requests
S3_SERVICE_COMPLAINTS_PATH=s3a://replace-with-data-lake-bucket/bronze/operational/service_complaints
S3_ZONE_STATE_HISTORY_PATH=s3a://replace-with-data-lake-bucket/bronze/zone_state_history

F1_FORMAT=csv
F3_FORMAT=csv
F7_FORMAT=csv
TRIP_REQUESTS_FORMAT=csv
SERVICE_COMPLAINTS_FORMAT=csv
ZONE_STATE_HISTORY_FORMAT=csv
AIRFLOW_TIMEZONE=America/New_York
SPARK_TIMEZONE=America/New_York
HADOOP_AWS_VERSION=3.5.0
SPARK_JARS_PACKAGES=
