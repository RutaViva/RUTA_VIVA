# Configuración de base de datos PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin1234
POSTGRES_DB=rutaviva_db

# URLs de conexión (Host local)
DATABASE_URL=postgresql+psycopg://admin:admin1234@localhost:5438/rutaviva_db
RABBITMQ_URL=amqp://admin:admin1234@localhost:5672/

# URLs de conexión dentro de Docker
DOCKER_DATABASE_URL=postgresql+psycopg://admin:admin1234@db:5432/rutaviva_db
DOCKER_RABBITMQ_URL=amqp://admin:admin1234@rabbitmq:5672/

# Parámetros RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin1234
RABBITMQ_DEFAULT_VHOST=/

# Parámetros del Seed determinista
SEED=42
NP_SEED=42

# API y umbrales de negocio
FRESHNESS_THRESHOLD_SECONDS=300
AUDITOR_API_KEY=auditor-secret-token

# Parámetros de simulación de defectos (HU-02)
SILENT_VEHICLES_PCT=5.0
OUT_OF_CITY_PCT=3.0
DEFECT_DELAY_SECONDS=60


# Batch/Airflow. Debe existir y estar montado en el worker de Airflow.
BRONZE_LANDING_DIR=/opt/airflow/data/landing

# AWS: reemplaza "reemplaza-con-tu-bucket" por el nombre real de tu bucket S3.
# Spark usa s3a://; no incluyas una barra final en las rutas.
S3_BRONZE_PATH=s3a://reemplaza-con-tu-bucket/bronze
S3_SILVER_PATH=s3a://reemplaza-con-tu-bucket/silver
S3_QUARANTINE_PATH=s3a://reemplaza-con-tu-bucket/quarantine
S3_GOLD_PATH=s3a://reemplaza-con-tu-bucket/gold

# Para AWS real, deja S3_ENDPOINT vacío y usa addressing style virtual-hosted.
S3_ENDPOINT=
S3_PATH_STYLE_ACCESS=false
# Cambia a la región donde está creado tu bucket.
AWS_REGION=us-east-1
# Para MinIO/LocalStack, reemplaza estos valores con credenciales locales:
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# Puedes sobrescribir las subcarpetas predeterminadas de S3_BRONZE_PATH.
S3_F1_PATH=s3a://reemplaza-con-tu-bucket/bronze/f1
S3_WEATHER_PATH=s3a://reemplaza-con-tu-bucket/bronze/f3
S3_EVENTS_PATH=s3a://reemplaza-con-tu-bucket/bronze/f7
S3_TRIP_REQUESTS_PATH=s3a://reemplaza-con-tu-bucket/bronze/operational/trip_requests
S3_SERVICE_COMPLAINTS_PATH=s3a://reemplaza-con-tu-bucket/bronze/operational/service_complaints
S3_ZONE_STATE_HISTORY_PATH=s3a://reemplaza-con-tu-bucket/bronze/zone_state_history

# Formato de cada fuente: csv, json o parquet.
F1_FORMAT=csv
F3_FORMAT=csv
F7_FORMAT=csv
TRIP_REQUESTS_FORMAT=csv
SERVICE_COMPLAINTS_FORMAT=csv
ZONE_STATE_HISTORY_FORMAT=csv

# Airflow PostgreSQL connection for monthly operational extraction.
AIRFLOW_POSTGRES_CONN_ID=postgres_default
AIRFLOW_TIMEZONE=America/New_York

# Credenciales de Airflow. Reemplaza todos los valores de ejemplo antes de iniciar.
# Genera AIRFLOW_FERNET_KEY con:
# docker run --rm apache/airflow:3.3.2-python3.12 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Genera las contraseñas/secrets con: python -c "import secrets; print(secrets.token_hex(32))"
# Mantén las contraseñas PostgreSQL en hexadecimal para que sean seguras en URI sin codificación.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-password
AIRFLOW_DB_PASSWORD=replace-with-64-hex-characters
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_API_JWT_SECRET=replace-with-64-hex-characters
AIRFLOW_API_SECRET_KEY=replace-with-64-hex-characters
AIRFLOW_POSTGRES_USER=airflow_reader
AIRFLOW_POSTGRES_PASSWORD=replace-with-64-hex-characters

# Para AWS real, usa credenciales de IAM role o agrega credenciales AWS en el entorno.
# Para MinIO/LocalStack, define AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY.
AIRFLOW_AWS_CONN_ID=aws_default
SPARK_TIMEZONE=America/New_York
SPARK_JARS_PACKAGES=
HADOOP_AWS_VERSION=3.5.0