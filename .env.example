# Configuración de base de datos PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# URLs de conexión (Host local)
DATABASE_URL=
RABBITMQ_URL=

# URLs de conexión dentro de Docker
DOCKER_DATABASE_URL=
DOCKER_RABBITMQ_URL=

# Parámetros RabbitMQ
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=

# Parámetros del Seed determinista (F4: 8000 vehículos, F6: 8000 conductores)
SEED=
NP_SEED=
SEED_DRIVERS=8000
SEED_VEHICLES=8000
SEED_CLEAN=false

# Worker de Presión y Loteo de Telemetría (F4: 533 msg/s)
BATCH_SIZE=1000

# Simulador de Solicitudes (F5: >= 30 req/s pico)
REQUESTS_PER_SECOND=30.0
BURST_ENABLED=true

# API y umbrales de negocio
FRESHNESS_THRESHOLD_SECONDS=
AUDITOR_API_KEY=

# Parámetros de simulación de defectos (HU-02)
SILENT_VEHICLES_PCT=
OUT_OF_CITY_PCT=
DEFECT_DELAY_SECONDS=