# Lo lee la imagen de Postgres (vía env_file en el compose).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Lo lee Alembic desde tu terminal. Valores literales a propósito:
# host = localhost, puerto = 5438 (el que publica el compose).
DATABASE_URL=

FRESHNESS_THRESHOLD_SECONDS=300

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

SILENT_VEHICLES_PCT=5.0        # Porcentaje de vehículos silenciosos
OUT_OF_CITY_PCT=3.0            # Porcentaje de vehículos fuera de la ciudad
DEFECT_DELAY_SECONDS=60        # Segundos antes de activar los defectos