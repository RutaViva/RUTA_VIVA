          "multiplier": {
            "type": "number",
            "title": "Multiplier"
          },
          "computed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Computed At"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded"
          }
        },
        "type": "object",
        "required": [
          "zone_id",
          "multiplier",
          "computed_at",
          "degraded"
        ],
        "title": "MultiplierResponse"
      },
      "NameZone": {
        "properties": {
          "zone_id": {
            "type": "integer",
            "title": "Zone Id"
          },
          "zone_name": {
            "type": "string",
            "title": "Zone Name"
          },
          "borough": {
            "type": "string",
            "title": "Borough"
          }
        },
        "type": "object",
        "required": [
          "zone_id",
          "zone_name",
          "borough"
        ],
        "title": "NameZone"
      },
      "TripCreateRequest": {
        "properties": {
          "zone_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 265.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone Id",
            "description": "ID de la zona de origen del viaje (1-265)"
          },
          "origin_zone_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 265.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin Zone Id",
            "description": "Alias de zone_id (zona de origen)"
          },
          "base_fare": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Fare",
            "description": "Tarifa base fija estimada para el viaje en USD"
          },
          "passenger_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passenger Id",
            "description": "UUID del pasajero que solicita el servicio"
          },
          "destination_zone_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 265.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination Zone Id",
            "description": "Zona de destino del viaje"
          },
          "estimated_distance_km": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Distance Km",
            "description": "Distancia estimada en kilómetros"
          },
          "estimated_duration_min": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Duration Min",
            "description": "Duración estimada en minutos"
          }
        },
        "type": "object",
        "title": "TripCreateRequest",
        "description": "Schema para creación/cotización de solicitudes de viaje.\nPermite tanto el envío directo de 'base_fare' como el cálculo automático\npor distancia y tiempo según la Regla de Negocio RN-01."
      },
      "TripResponse": {
        "properties": {
          "trip_id": {
            "type": "string",
            "format": "uuid",
            "title": "Trip Id"
          },
          "zone_id": {
            "type": "integer",
            "title": "Zone Id"
          },
          "requested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Requested At"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "base_fare": {
            "type": "number",
            "title": "Base Fare"
          },
          "multiplier": {
            "type": "number",
            "title": "Multiplier"
          },
          "charged_fare": {
            "type": "number",
            "title": "Charged Fare"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded"
          }
        },
        "type": "object",
        "required": [
          "trip_id",
          "zone_id",
          "requested_at",
          "status",
          "base_fare",
          "multiplier",
          "charged_fare",
          "degraded"
        ],
        "title": "TripResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}