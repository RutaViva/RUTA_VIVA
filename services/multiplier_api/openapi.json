    "/audit/{trip_id}": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Get Trip Fare Audit",
        "description": "Reconstruye matemáticamente cómo se calculó la tarifa de cualquier viaje (RF-04, CA-05).\nMuestra multiplicador, presión, clima, versión de reglas y estado de degradación.",
        "operationId": "get_trip_fare_audit_audit__trip_id__get",
        "parameters": [
          {
            "name": "trip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID de la solicitud de viaje a auditar",
              "title": "Trip Id"
            },
            "description": "UUID de la solicitud de viaje a auditar"
          },
          {
            "name": "X-Auditor-Role",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Auditor-Role"
            }
          },
          {
            "name": "X-User-Role",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Role"
            }
          },
          {
            "name": "X-Auditor-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Auditor-Key"
            }
          },
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Audit-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FareAuditResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
